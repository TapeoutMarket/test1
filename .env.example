# This file contains public defaults only. The TS CLI does NOT auto-load .env.
# Export explicitly reviewed variables in your shell. Never commit filled secrets.
MODE=mock
EXECUTION_RPC_URL=http://127.0.0.1:8545
FORK_SOURCE_RPC_URL=
SOURCE_CHAIN_ID=56
EXPECTED_EXECUTION_CHAIN_ID=56
FORK_BLOCK_NUMBER=
FORK_BLOCK_HASH=
# Primary path: start this machine's fork on loopback; no LAN gateway needed.
FORK_LOCAL_PORT=18545
# The node terminal receives the private source RPC. In the test terminal,
# use local-session.json's sourceProxyURL for FORK_SOURCE_RPC_URL.
# loopback = Anvil on this machine; lan-relay = explicitly verified remote Anvil fork
FORK_EXECUTION_TOPOLOGY=loopback
FORK_SESSION_ID=
# Host Mac only: assigned RFC1918 IPv4 and exact client IPv4 allowlist (comma-separated).
# Host reads source RPC from its own process environment; never copy credentials into reports.
FORK_BIND_HOST=
FORK_GATEWAY_PORT=18545
FORK_INTERNAL_PORT=18546
FORK_ALLOWED_CLIENT_IPS=
# Fresh public test account addresses, comma-separated. Never use private keys.
FORK_SANDBOX_ACCOUNTS=
# Client relay only; token must be passed privately, not committed or pasted into chat.
FORK_GATEWAY_URL=
FORK_GATEWAY_TOKEN=
FORK_RELAY_PORT=18547
# Read-only fork:prepare; use verified real protocol addresses for the selected block.
FORK_MINING_ADDRESS=
FORK_BEM_ADDRESS=
# Optional fork-created order variant. Only loopback fork approval + validate; no signature.
# FORK_ORDER_ORIGIN=fork-created
# FORK_SELLER_ADDRESS=<public owner address>
# FORK_COLLECTION_ADDRESS=<real ERC721 collection>
# FORK_TOKEN_ID=<owned miner ID>
# FORK_MARKET_ADDRESS=<verified Seaport>
# FORK_FEE_RECIPIENT=<explicit fork test fee recipient>
# Optional: omit these entirely to use computed defaults (do not export empty strings).
# FORK_CASE_NAME=miner-3204-run1
# FORK_SAFETY_MARGIN=300
# FORK_DEADLINE=<explicit uint64 timestamp>
MARKET_API_BASE_URL=
# Exact JSON array; no discovery, no redirects, no remote origins.
# [{"path":"/groupbuy/order","method":"GET","operation":"read-order"}]
MARKET_API_READ_ALLOWLIST=
ORDER_FILE=fixtures/seaport-order.example.json
# Unused in mock/fork; addresses are provided with --from and Anvil is unlocked.
DEPLOYER_PRIVATE_KEY=
PARTICIPANT_A_PRIVATE_KEY=
PARTICIPANT_B_PRIVATE_KEY=
FACTORY_ADDRESS=
VAULT_ADDRESS=
EXPECTED_TEMPLATE=
EXPECTED_CODE_HASH=
GOVERNANCE_MULTISIG=
GUARDIAN_ADDRESS=
TIMELOCK_MIN_DELAY=
ALLOW_LIVE_SEND=false
LIVE_RELEASE_VERIFIED=false
# Additional live identity gate: reviewed public manifest under this repository.
# EXPECTED_MANIFEST_HASH is keccak256 of the exact UTF-8 file bytes (including newline).
LIVE_MANIFEST_FILE=
EXPECTED_MANIFEST_HASH=
MAX_TX_FEE_BNB=
MAX_TOTAL_TEST_SPEND_BNB=
